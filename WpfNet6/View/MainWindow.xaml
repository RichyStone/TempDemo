<Window
    x:Class="WpfNet6.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bind="http://CommonUILib/UIResource/BindingProxy"
    xmlns:cus="http://CommonUILib/UIResource/UserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="clr-namespace:WpfNet6.Model.Enum"
    xmlns:enumBind="clr-namespace:CommonUILib.EnumBindingExtension;assembly=CommonUILib"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WpfNet6.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="clr-namespace:WpfNet6.ViewModel"
    Title="MainWindow"
    Width="1300"
    Height="800"
    DataContext="{Binding Source={StaticResource Locator}, Path=MainViewModel}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <bind:BindingProxy x:Key="BindingProxy" Data="{Binding ElementName=Login}" />

                    <!--  EnumBindingMethod1  -->
                    <ObjectDataProvider x:Key="TaskStateDataProvider" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                        <ObjectDataProvider.MethodParameters>
                            <x:Type TypeName="enum:TaskState" />
                        </ObjectDataProvider.MethodParameters>
                    </ObjectDataProvider>

                    <!--  EnumBindingMethod2  -->
                    <enumBind:EnumBindingSource x:Key="TaskSateSource" EnumType="{x:Type enum:TaskState}" />

                    <!--  EnumBindingMethod3  -->
                    <x:Array x:Key="TaskStateSourceArray" Type="enum:TaskState">
                        <x:Static Member="enum:TaskState.Running" />
                        <x:Static Member="enum:TaskState.Error" />
                        <x:Static Member="enum:TaskState.Wait" />
                    </x:Array>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="BorderAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="912">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:02" Value="-220">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:03" Value="1.25" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="492">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:02" Value="502">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:03" Value="2.75" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(Canvas.Left)">
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="270">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:02" Value="270" />
                    <EasingDoubleKeyFrame KeyTime="00:00:03" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(Canvas.Top)">
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="20">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:02" Value="20" />
                    <EasingDoubleKeyFrame KeyTime="00:00:03" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.5">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ColorAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="00:00:01" Value="#FF4848E8">
                        <EasingColorKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseIn" />
                        </EasingColorKeyFrame.EasingFunction>
                    </EasingColorKeyFrame>
                    <EasingColorKeyFrame KeyTime="00:00:02" Value="#FF09D415">
                        <EasingColorKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseIn" />
                        </EasingColorKeyFrame.EasingFunction>
                    </EasingColorKeyFrame>
                    <EasingColorKeyFrame KeyTime="00:00:03" Value="#FFD4094A">
                        <EasingColorKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseIn" />
                        </EasingColorKeyFrame.EasingFunction>
                    </EasingColorKeyFrame>
                </ColorAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:01" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:02" Value="-359.457">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseInOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:03" Value="90.11" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <TabControl>
            <TabItem Header="Login">
                <Grid>
                    <Grid.RowDefinitions>

                        <RowDefinition />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <local:UcLogin x:Name="Login" VerticalAlignment="Top" />

                    <UniformGrid
                        Grid.Row="1"
                        Columns="3"
                        FirstColumn="1"
                        Rows="3">
                        <TextBlock d:Text="DesginTime" Text="{Binding ReciveMessage, FallbackValue=ss}" />
                        <TextBlock Text="{Binding Source={StaticResource BindingProxy}, Path=Data.Name}" />
                        <TextBlock Text="{Binding Test, FallbackValue=FallBack}" />
                        <TextBlock Text="{Binding Test, TargetNullValue=TargetNull}" />
                        <TextBlock d:Text="DesginTime" Text="Test" />
                        <TextBox Text="{Binding ValidateTest}" />
                        <TextBox Text="{Binding ValidateTest}" />
                        <cus:CustomTextBox IsHighLighted="True" />
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Margin="10" Orientation="Vertical">
                        <ComboBox ItemsSource="{Binding Source={StaticResource TaskStateDataProvider}}" />
                        <ComboBox ItemsSource="{enumBind:EnumBindingSource EnumType=enum:TaskState}" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource TaskStateSourceArray}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="10,20" Orientation="Horizontal">
                        <Button Content="Close">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:CallMethodAction MethodName="Close" TargetObject="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Window}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Animation">
                <Canvas>
                    <Border
                        x:Name="border"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="50"
                        Height="50"
                        Background="#FFD4094A"
                        BorderBrush="#FF9CC534"
                        BorderThickness="2"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>

                    <Button Canvas.Left="80" Canvas.Top="10" Content="StartAnimation">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <i:ControlStoryboardAction ControlStoryboardOption="Play" Storyboard="{StaticResource BorderAnimation}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                </Canvas>
            </TabItem>
        </TabControl>




    </Grid>
</Window>